# --- GENERAL CONFIGURATION ---
APP_NAME=demo
MULTIPART_MAX_FILE_SIZE=50MB
MULTIPART_MAX_REQUEST_SIZE=50MB

# --- GEMINI AI API---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_IMAGE=your_gemini_image_api_key_here

# --- MYSQL DATABASE ---
DB_URL=jdbc:mysql://localhost:3306/your_database_name
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# --- MONGODB ---
MONGODB_DATABASE=pdfstore
MONGODB_URI=mongodb://localhost:27017/pdfstore

# --- CLOUDINARY (Lấy từ Dashboard Cloudinary) ---
CLOUDINARY_WEBHOOK_SECRET=your_webhook_secret
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name

# --- REDIS (Cấu hình bộ nhớ đệm) ---
REDIS_HOST=your_redis_host
REDIS_PORT=16288
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# --- MAIL SERVER (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# --- SECURITY & JWT ---
# Tạo một chuỗi ngẫu nhiên dài để làm Secret Key
JWT_SECRET_KEY=your_very_long_random_secret_key_here
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Thời gian sống của Token (tính bằng giây/phút tùy logic code)
TOKEN_REFRESH_TIME=259200
TOKEN_ACCESS_TIME=100000
TOKEN_REGISTRATION_TIME=5

# --- FILE PATHS (Đường dẫn hệ thống) ---
INSTRUCTION_PATH=/instructions/instructionV5.txt
REGEN_INSTRUCTION_PATH=/instructions/regeninstruction.txt
TESSERACT_PATH=./tessdata
WORD_FILE_PATH=/templates/test_template.docx
DONATE_FILE_PATH=/donate/donate.txt